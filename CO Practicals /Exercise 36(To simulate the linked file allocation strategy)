#include <stdio.h>

int main()
{
    int block[20], next[20];
    int n, i;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &block[i]);
    }

    for (i = 0; i < n - 1; i++)
    {
        next[i] = i + 1;
    }

    next[n - 1] = -1;

    printf("\nLinked File Allocation:\n");

    printf("First Block = %d\n", block[0]);
    printf("Last Block = %d\n", block[n - 1]);

    printf("\nBlock -> Next Block\n");

    for (i = 0; i < n; i++)
    {
        if (next[i] == -1)
            printf("%d -> NULL\n", block[i]);
        else
            printf("%d -> %d\n", block[i], block[next[i]]);
    }

    printf("\nFile Block Sequence:\n");

    i = 0;

    while (i != -1)
    {
        printf("%d ", block[i]);
        i = next[i];
    }

    printf("\n");

    return 0;
}
