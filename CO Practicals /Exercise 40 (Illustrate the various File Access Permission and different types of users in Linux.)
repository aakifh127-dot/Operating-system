#include <stdio.h>
#include <sys/stat.h>

int main()
{
    struct stat file;
    char filename[50];

    printf("Enter file name: ");
    scanf("%s", filename);

    if (stat(filename, &file) == -1)
    {
        printf("File not found\n");
        return 1;
    }

    printf("\nFile Access Permissions:\n");

    printf("User   : ");
    printf((file.st_mode & S_IRUSR) ? "Read " : "");
    printf((file.st_mode & S_IWUSR) ? "Write " : "");
    printf((file.st_mode & S_IXUSR) ? "Execute" : "");
    
    printf("\nGroup  : ");
    printf((file.st_mode & S_IRGRP) ? "Read " : "");
    printf((file.st_mode & S_IWGRP) ? "Write " : "");
    printf((file.st_mode & S_IXGRP) ? "Execute" : "");

    printf("\nOthers : ");
    printf((file.st_mode & S_IROTH) ? "Read " : "");
    printf((file.st_mode & S_IWOTH) ? "Write " : "");
    printf((file.st_mode & S_IXOTH) ? "Execute" : "");

    printf("\n");

    return 0;
}
