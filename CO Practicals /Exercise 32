#include <stdio.h>

int main() {
    int pages[50], frames[10], recent[10];
    int n, f, i, j, k;
    int pageFaults = 0, pageHits = 0;
    int found, lru, min;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    // Initialize frames
    for (i = 0; i < f; i++) {
        frames[i] = -1;
        recent[i] = 0;
    }

    printf("\nPage\tFrames\t\tStatus\n");

    // LRU page replacement
    for (i = 0; i < n; i++) {
        found = 0;

        // Check if page is already present
        for (j = 0; j < f; j++) {
            if (frames[j] == pages[i]) {
                found = 1;
                recent[j] = i + 1;
                break;
            }
        }

        // Page hit
        if (found) {
            pageHits++;
        }
        // Page fault
        else {
            pageFaults++;

            // Find an empty frame first
            for (j = 0; j < f; j++) {
                if (frames[j] == -1)
                    break;
            }

            // If no empty frame, find least recently used page
            if (j == f) {
                min = recent[0];
                lru = 0;

                for (k = 1; k < f; k++) {
                    if (recent[k] < min) {
                        min = recent[k];
                        lru = k;
                    }
                }

                j = lru;
            }

            frames[j] = pages[i];
            recent[j] = i + 1;
        }

        // Display current frames
        printf("%d\t", pages[i]);

        for (j = 0; j < f; j++) {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        if (found)
            printf("\tHit\n");
        else
            printf("\tPage Fault\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits   = %d\n", pageHits);

    return 0;
}
