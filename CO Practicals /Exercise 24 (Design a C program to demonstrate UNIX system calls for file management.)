#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buffer[100];
    int n;

    fd = open("sample.txt", O_RDWR | O_CREAT, 0644);

    if (fd < 0)
    {
        printf("Unable to open file.\n");
        return 1;
    }

    write(fd, "Hello UNIX File Management", 27);

    lseek(fd, 0, SEEK_SET);

    n = read(fd, buffer, 27);
    buffer[n] = '\0';

    printf("File content: %s\n", buffer);

    close(fd);

    return 0;
}
