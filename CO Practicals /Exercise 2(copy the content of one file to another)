#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int source, destination, bytesRead;
    char buffer[100];

    /* Create source file */
    source = open("source.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (source < 0)
    {
        printf("Unable to create source file.\n");
        return 1;
    }

    write(source, "Hello World\nThis is a source file.", 34);
    close(source);

    /* Open source file for reading */
    source = open("source.txt", O_RDONLY);

    if (source < 0)
    {
        printf("Unable to open source file.\n");
        return 1;
    }

    /* Create destination file */
    destination = open("destination.txt",
                       O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (destination < 0)
    {
        printf("Unable to create destination file.\n");
        close(source);
        return 1;
    }

    /* Copy file */
    while ((bytesRead = read(source, buffer, sizeof(buffer))) > 0)
    {
        write(destination, buffer, bytesRead);
    }

    close(source);
    close(destination);

    printf("File copied successfully.\n");

    return 0;
}
