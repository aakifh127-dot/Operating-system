#include <stdio.h>

int main()
{
    int index[20];
    int n, i, pos;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &index[i]);
    }

    printf("\nIndex Block:\n");

    for (i = 0; i < n; i++)
    {
        printf("Index %d -> Block %d\n", i + 1, index[i]);
    }

    printf("\nEnter block position to access: ");
    scanf("%d", &pos);

    if (pos < 1 || pos > n)
    {
        printf("Invalid position.\n");
    }
    else
    {
        printf("Index %d points to Block %d\n",
               pos, index[pos - 1]);
    }

    return 0;
}
