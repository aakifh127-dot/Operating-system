#include <stdio.h>

int main()
{
    int request[20];
    int n, head, disk, i, j, temp;
    int total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk);

    /* Sort the requests */
    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nSCAN Order:\n");

    /* Move towards higher cylinders */
    for (i = 0; i < n; i++)
    {
        if (request[i] >= head)
        {
            total += request[i] - head;
            head = request[i];
            printf("%d ", head);
        }
    }

    /* Move to the end of the disk */
    total += (disk - 1) - head;
    head = disk - 1;

    printf("%d ", head);

    /* Reverse direction */
    for (i = n - 1; i >= 0; i--)
    {
        if (request[i] < head)
        {
            total += head - request[i];
            head = request[i];
            printf("%d ", head);
        }
    }

    printf("\n\nTotal Head Movement = %d\n", total);

    return 0;
}
