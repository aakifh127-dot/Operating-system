#include <stdio.h>

int main()
{
    int request[20];
    int n, head, disk;
    int i, j, temp;
    int total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk);

    /* Sort the request queue */
    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nC-SCAN Order:\n");

    /* Move towards higher cylinder numbers */
    for (i = 0; i < n; i++)
    {
        if (request[i] >= head)
        {
            total += request[i] - head;
            head = request[i];
            printf("%d ", head);
        }
    }

    /* Move to the end of disk */
    total += (disk - 1) - head;
    head = disk - 1;
    printf("%d ", head);

    /* Jump to beginning */
    total += head;
    head = 0;
    printf("%d ", head);

    /* Continue servicing remaining requests */
    for (i = 0; i < n; i++)
    {
        if (request[i] < head)
        {
            total += request[i] - head;
            head = request[i];
            printf("%d ", head);
        }
    }

    printf("\n\nTotal Head Movement = %d\n", total);

    return 0;
}
