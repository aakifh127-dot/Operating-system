#include <stdio.h>

int buffer[5];
int in = 0, out = 0;
int count = 0;

void produce(int item)
{
    if (count == 5)
    {
        printf("Buffer is full\n");
        return;
    }

    buffer[in] = item;
    in = (in + 1) % 5;
    count++;

    printf("Produced: %d\n", item);
}

void consume()
{
    int item;

    if (count == 0)
    {
        printf("Buffer is empty\n");
        return;
    }

    item = buffer[out];
    out = (out + 1) % 5;
    count--;

    printf("Consumed: %d\n", item);
}

int main()
{
    int i;

    printf("Producer-Consumer Problem\n\n");

    for (i = 1; i <= 5; i++)
    {
        produce(i);
    }

    for (i = 1; i <= 3; i++)
    {
        consume();
    }

    return 0;
}
