1. File Allocation – Contiguous, Linked and Indexed

Coding:

#include <stdio.h>

#define MAX 1000

int main()
{
    int disk[MAX] = {0};
    int n, fileSize, method;
    int i, j, start = -1, count;
    int indexBlock;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter file size (number of blocks): ");
    scanf("%d", &fileSize);

    printf("\n1. Contiguous\n");
    printf("2. Linked\n");
    printf("3. Indexed\n");
    printf("Enter allocation method: ");
    scanf("%d", &method);

    if (fileSize > n || fileSize <= 0)
    {
        printf("Invalid file size.\n");
        return 0;
    }

    /* Contiguous Allocation */
    if (method == 1)
    {
        for (i = 0; i <= n - fileSize; i++)
        {
            count = 0;

            for (j = i; j < i + fileSize; j++)
            {
                if (disk[j] == 0)
                    count++;
            }

            if (count == fileSize)
            {
                start = i;
                break;
            }
        }

        if (start == -1)
        {
            printf("\nContiguous allocation failed.\n");
            printf("Sufficient continuous space is not available.\n");
        }
        else
        {
            printf("\nAllocated blocks: ");
            for (i = start; i < start + fileSize; i++)
            {
                disk[i] = 1;
                printf("%d ", i);
            }
            printf("\n");
        }
    }

    /* Linked Allocation */
    else if (method == 2)
    {
        count = 0;

        printf("\nAllocated blocks: ");

        for (i = 0; i < n && count < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        if (count < fileSize)
        {
            printf("\nAllocation failed. Not enough free blocks.\n");
        }
        else
        {
            printf("\nLinked allocation successful.\n");
        }
    }

    /* Indexed Allocation */
    else if (method == 3)
    {
        if (fileSize + 1 > n)
        {
            printf("\nIndexed allocation failed.\n");
            printf("Not enough blocks for index block and data blocks.\n");
            return 0;
        }

        /* First free block is used as index block */
        indexBlock = -1;

        for (i = 0; i < n; i++)
        {
            if (disk[i] == 0)
            {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }

        count = 0;

        printf("\nIndex block: %d", indexBlock);
        printf("\nAllocated data blocks: ");

        for (i = 0; i < n && count < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        if (count < fileSize)
        {
            printf("\nAllocation failed.\n");
        }
        else
        {
            printf("\nIndexed allocation successful.\n");
        }
    }

    else
    {
        printf("\nInvalid allocation method.\n");
    }

    return 0;
}

