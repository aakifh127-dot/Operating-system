#include <stdio.h>
#include <stdlib.h>

#define MAX 1000

int disk[MAX];

int contiguous(int n, int size, int allocated[])
{
    int i, j, count;

    for (i = 0; i <= n - size; i++)
    {
        count = 0;

        for (j = i; j < i + size; j++)
        {
            if (disk[j] == 0)
                count++;
        }

        if (count == size)
        {
            for (j = 0; j < size; j++)
            {
                disk[i + j] = 1;
                allocated[j] = i + j;
            }

            return size;
        }
    }

    return 0;
}

int indexed(int n, int size, int allocated[])
{
    int i, count = 0;
    int indexBlock = -1;

    if (size + 1 > n)
        return 0;

    /* Allocate index block */
    for (i = 0; i < n; i++)
    {
        if (disk[i] == 0)
        {
            indexBlock = i;
            disk[i] = 1;
            break;
        }
    }

    if (indexBlock == -1)
        return 0;

    /* Allocate data blocks */
    for (i = 0; i < n && count < size; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            allocated[count] = i;
            count++;
        }
    }

    if (count < size)
        return 0;

    return size;
}

int fcfs(int request[], int n, int head)
{
    int i;
    int current = head;
    int seek = 0;

    printf("Seek Sequence: %d", head);

    for (i = 0; i < n; i++)
    {
        seek += abs(current - request[i]);
