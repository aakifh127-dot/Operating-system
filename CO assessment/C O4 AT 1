2. Bitmap Free Space Management

Coding:

#include <stdio.h>

#define MAX 1000

int main()
{
    int bitmap[MAX];
    int n, i, request;
    int count = 0;
    int deallocCount, block;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter bitmap (0 = free, 1 = allocated):\n");

    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);

    printf("\nInitial Bitmap:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    /* Allocation */
    printf("\n\nEnter number of blocks to allocate: ");
    scanf("%d", &request);

    for (i = 0; i < n; i++)
    {
        if (bitmap[i] == 0)
            count++;
    }

    if (count < request)
    {
        printf("Allocation failed.\n");
        printf("Only %d free blocks are available.\n", count);
    }
    else
    {
        count = 0;

        for (i = 0; i < n && count < request; i++)
        {
            if (bitmap[i] == 0)
            {
                bitmap[i] = 1;
                count++;
            }
        }

        printf("Allocation successful.\n");

        printf("Updated Bitmap after allocation:\n");
        for (i = 0; i < n; i++)
            printf("%d ", bitmap[i]);
    }

    /* Deallocation */
    printf("\n\nEnter number of blocks to deallocate: ");
    scanf("%d", &deallocCount);

    printf("Enter block numbers to deallocate:\n");

    for (i = 0; i < deallocCount; i++)
    {
        scanf("%d", &block);

        if (block >= 0 && block < n)
        {
            if (bitmap[block] == 1)
            {
                bitmap[block] = 0;
                printf("Block %d deallocated.\n", block);
            }
            else
            {
                printf("Block %d is already free.\n", block);
            }
        }
        else
        {
            printf("Invalid block number: %d\n", block);
        }
    }

    printf("\nFinal Bitmap:\n");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    printf("\n");

    return 0;
}

