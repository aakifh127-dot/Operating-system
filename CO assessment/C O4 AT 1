void cscan(int request[], int n, int head, int diskSize, int direction)
{
    int left[MAX], right[MAX];
    int l = 0, r = 0;
    int i, j, temp;
    int current = head;
    int seek = 0;

    for (i = 0; i < n; i++)
    {
        if (request[i] < head)
            left[l++] = request[i];
        else
            right[r++] = request[i];
    }

    /* Sort arrays */
    for (i = 0; i < l - 1; i++)
        for (j = i + 1; j < l; j++)
            if (left[i] > left[j])
            {
                temp = left[i];
                left[i] = left[j];
                left[j] = temp;
            }

    for (i = 0; i < r - 1; i++)
        for (j = i + 1; j < r; j++)
            if (right[i] > right[j])
            {
                temp = right[i];
                right[i] = right[j];
                right[j] = temp;
            }

    printf("\nC-SCAN Seek Sequence: %d", head);

    if (direction == 1)       /* Right */
    {
        for (i = 0; i < r; i++)
        {
            seek += abs(current - right[i]);
            current = right[i];
            printf(" -> %d", current);
        }

        seek += abs(current - (diskSize - 1));
        current = diskSize - 1;
        printf(" -> %d", current);

        seek += diskSize - 1;
        current = 0;
        printf(" -> %d", current);

        for (i = 0; i < l; i++)
        {
            seek += abs(current - left[i]);
            current = left[i];
            printf(" -> %d", current);
        }
    }
    else                       /* Left */
    {
        for (i = l - 1; i >= 0; i--)
        {
            seek += abs(current - left[i]);
            current = left[i];
            printf(" -> %d", current);
        }

        seek += current;
        current = 0;
        printf(" -> %d", current);

        seek += diskSize - 1;
        current = diskSize - 1;
        printf(" -> %d", current);

        for (i = r - 1; i >= 0; i--)
        {
            seek += abs(current - right[i]);
            current = right[i];
            printf(" -> %d", current);
        }
    }

    printf("\nTotal C-SCAN Head Movement = %d\n", seek);
}

